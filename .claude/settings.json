{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/lint_design.sh 2>&1 | tail -80"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR && swift build 2>&1 | grep -E 'error:|Build complete|warning:.*error' | tail -20"
          }
        ]
      }
    ]
  }
}
